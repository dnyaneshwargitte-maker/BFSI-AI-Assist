# -----------------------------------------------------------------------------
# CloudifyOps BFSI Intelligence Platform - Environment Variables
# Copy to .env and fill real values before docker-compose up
# -----------------------------------------------------------------------------

# PostgreSQL 15 Configuration  (Docker service name = postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=bfsi_secure_pass_2025
DB_NAME=bfsi_db
DATABASE_URL=postgresql://postgres:bfsi_secure_pass_2025@postgres:5432/bfsi_db

# Docker Compose PostgreSQL vars (must match DB_ vars above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bfsi_secure_pass_2025
POSTGRES_DB=bfsi_db

# EC2 & Domain Configuration (replace IP with your Elastic IP)
# Format for sslip.io free TLS: replace dots with dashes
# Example: 54.210.45.89  → 54-210-45-89.sslip.io
DOMAIN_NAME=YOUR_EC2_IP.sslip.io
LETSENCRYPT_EMAIL=admin@cloudifyops.com

# AWS Region & Credentials (IAM role on EC2 handles Bedrock; keys optional)
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Model
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
CONNECT_INSTANCE_ID=

